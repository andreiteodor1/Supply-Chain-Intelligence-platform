# Copy to .env and fill in ONE provider. With no key the agents run in
# deterministic mode: same SQL, same models, rule-based narrative.

# auto | openai | groq | ollama | mock
#   auto = openai if OPENAI_API_KEY is set, else groq if GROQ_API_KEY is set, else mock
LLM_PROVIDER=auto
LLM_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier works well for demos)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, no key; run `ollama pull llama3.1` first)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Optional: point at a different warehouse file
# CPG_DB_PATH=data/cpg_warehouse.duckdb
